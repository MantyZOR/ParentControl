<Window x:Class="ParentControl.ClientApp.WarningWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Предупреждение ParentControl" Width="390" SizeToContent="Height"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False" ShowActivated="False"
        Topmost="True" Background="#FFFEFA" FontFamily="Segoe UI Variable Text, Segoe UI"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="0" GlassFrameThickness="0"
                            CornerRadius="20" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>
    <Border Padding="24" CornerRadius="20" Background="#FFFEFA" BorderBrush="#DCE5DC" BorderThickness="1">
        <StackPanel>
            <Grid>
                <TextBlock Text="PARENTCONTROL  /  ВРЕМЯ" FontSize="11" FontWeight="SemiBold" Foreground="#347078"
                           VerticalAlignment="Center"/>
                <Button Content="×" Width="30" Height="30" HorizontalAlignment="Right" VerticalAlignment="Center"
                        ToolTip="Закрыть предупреждение" Click="Close_Click" FontSize="20" FontWeight="Bold"
                        Foreground="#52615E" Background="#E8EEEA" BorderThickness="0" Cursor="Hand">
                    <Button.Template><ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="15">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate></Button.Template>
                </Button>
            </Grid>
            <TextBlock x:Name="MinutesText" FontFamily="Georgia" FontSize="29" Foreground="#1A2929"
                       Margin="0,12,0,7"/>
            <TextBlock Text="Минуты продолжают расходоваться. Вы можете поставить банк на паузу и вернуться позже."
                       TextWrapping="Wrap" FontSize="14" Foreground="#52615E"/>
            <Button x:Name="PauseButton" Content="Сохранить минуты" Click="Pause_Click"
                    HorizontalAlignment="Center" Margin="0,18,0,0" Padding="17,10"
                    Background="#225B62" Foreground="#FBFCF8" BorderThickness="0"
                    FontWeight="SemiBold" Cursor="Hand">
                <Button.Template><ControlTemplate TargetType="Button">
                    <Border x:Name="Body" Background="{TemplateBinding Background}" CornerRadius="12"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Body" Property="Background" Value="#2D747C"/></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Body" Property="Opacity" Value="0.5"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate></Button.Template>
            </Button>
            <TextBlock x:Name="ErrorText" Foreground="#9B4F45" TextWrapping="Wrap" Margin="0,8,0,0"/>
        </StackPanel>
    </Border>
</Window>
