<Window x:Class="ParentControl.Overlay.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False"
        Background="#17292B" FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="15"
        Topmost="True" Title="Доступ ограничен"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType">
    <Window.Resources>
        <ImageBrush x:Key="Grain" ImageSource="/ParentControl.Overlay;component/Assets/grain.png" TileMode="Tile" ViewportUnits="Absolute"
                    Viewport="0,0,96,96" Stretch="Fill" Opacity="0.8"/>
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Background" Value="#225B62"/><Setter Property="Foreground" Value="#FBFCF8"/>
            <Setter Property="BorderBrush" Value="#1B4D53"/><Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="19,12"/><Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Grid>
                    <Border Background="{TemplateBinding Background}" CornerRadius="14">
                        <Border.Effect><DropShadowEffect Color="#152426" BlurRadius="11" ShadowDepth="2" Opacity="0.18"/></Border.Effect>
                    </Border>
                    <Border x:Name="Body" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="14" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </Grid>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Body" Property="Opacity" Value="0.88"/></Trigger>
                    <Trigger Property="IsPressed" Value="True"><Setter TargetName="Body" Property="Opacity" Value="0.72"/></Trigger>
                    <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Body" Property="Opacity" Value="0.48"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="SoftButton" TargetType="Button" BasedOn="{StaticResource ActionButton}">
            <Setter Property="Background" Value="#E9EFEB"/><Setter Property="Foreground" Value="#265159"/>
            <Setter Property="BorderBrush" Value="#D7E3DD"/>
        </Style>
        <Style x:Key="PowerCircleButton" TargetType="Button">
            <Setter Property="Width" Value="62"/><Setter Property="Height" Value="62"/>
            <Setter Property="Background" Value="#ECF2ED"/><Setter Property="Foreground" Value="#225B62"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Grid Width="62" Height="62">
                    <Ellipse x:Name="Halo" Fill="#39638A83" Stroke="#719EB3AA" StrokeThickness="1"/>
                    <Border x:Name="Body" Margin="4" Background="{TemplateBinding Background}" CornerRadius="29"
                            BorderBrush="#D8E7E0" BorderThickness="1">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </Grid>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="Body" Property="Background" Value="#FFFFFF"/>
                        <Setter TargetName="Halo" Property="Fill" Value="#587CB5AC"/>
                    </Trigger>
                    <Trigger Property="IsPressed" Value="True"><Setter TargetName="Body" Property="Opacity" Value="0.73"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="PageTabButton" TargetType="Button">
            <Setter Property="Width" Value="88"/><Setter Property="Height" Value="62"/>
            <Setter Property="Background" Value="#E5EEE7"/><Setter Property="Foreground" Value="#245C63"/>
            <Setter Property="BorderBrush" Value="#B9D2C7"/><Setter Property="BorderThickness" Value="0,1,1,1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Effect">
                <Setter.Value><DropShadowEffect Color="#061A1B" BlurRadius="14" ShadowDepth="4" Opacity="0.42"/></Setter.Value>
            </Setter>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Grid>
                    <Border x:Name="Join" Width="22" HorizontalAlignment="Left" Margin="0,1,0,1"
                            Background="{TemplateBinding Background}" Visibility="Collapsed"/>
                    <Border x:Name="TabSurface" Margin="18,0,0,0" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="0,17,17,0">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </Grid>
                <ControlTemplate.Triggers>
                    <Trigger Property="Tag" Value="Active">
                        <Setter TargetName="Join" Property="Visibility" Value="Visible"/>
                    </Trigger>
                    <MultiTrigger>
                        <MultiTrigger.Conditions>
                            <Condition Property="Tag" Value="Inactive"/>
                            <Condition Property="IsMouseOver" Value="True"/>
                        </MultiTrigger.Conditions>
                        <Setter TargetName="TabSurface" Property="Background" Value="#F1F7F1"/>
                    </MultiTrigger>
                    <Trigger Property="IsPressed" Value="True">
                        <Setter TargetName="TabSurface" Property="Opacity" Value="0.76"/>
                    </Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
            <Style.Triggers>
                <Trigger Property="Tag" Value="Active">
                    <Setter Property="Background" Value="#FFFEFA"/>
                    <Setter Property="BorderBrush" Value="#E5E9E1"/>
                    <Setter Property="Effect" Value="{x:Null}"/>
                    <Setter Property="Panel.ZIndex" Value="3"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="InputStyle" TargetType="TextBox">
            <Setter Property="Background" Value="#F8FAF6"/><Setter Property="Foreground" Value="#1A2929"/>
            <Setter Property="BorderBrush" Value="#D7E0DA"/><Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="13,11"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox">
                <Border x:Name="Field" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="12">
                    <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Field" Property="BorderBrush" Value="#287C83"/><Setter TargetName="Field" Property="BorderThickness" Value="2"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="PasswordStyle" TargetType="PasswordBox">
            <Setter Property="Background" Value="#F8FAF6"/><Setter Property="Foreground" Value="#1A2929"/>
            <Setter Property="BorderBrush" Value="#D7E0DA"/><Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="13,11"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="PasswordBox">
                <Border x:Name="Field" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="12">
                    <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Field" Property="BorderBrush" Value="#287C83"/><Setter TargetName="Field" Property="BorderThickness" Value="2"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
    </Window.Resources>
    <Grid ClipToBounds="True" Background="#17292B">
        <Image x:Name="BackgroundImage" Stretch="UniformToFill" Opacity="0.6"/>
        <Border Background="#A817292B"/>
        <Ellipse Width="950" Height="780" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-410,-340,0" IsHitTestVisible="False">
            <Ellipse.Fill><RadialGradientBrush><GradientStop Color="#8065B7B3" Offset="0"/><GradientStop Color="#0065B7B3" Offset="1"/></RadialGradientBrush></Ellipse.Fill>
        </Ellipse>
        <Ellipse Width="700" Height="620" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="-320,0,0,-350" IsHitTestVisible="False">
            <Ellipse.Fill><RadialGradientBrush><GradientStop Color="#685F312D" Offset="0"/><GradientStop Color="#005F312D" Offset="1"/></RadialGradientBrush></Ellipse.Fill>
        </Ellipse>
        <Rectangle Fill="{StaticResource Grain}" IsHitTestVisible="False"/>

        <Grid x:Name="LockCardHost" Width="580" Height="570" Margin="24"
              HorizontalAlignment="Center" VerticalAlignment="Center">
            <Path x:Name="RulesEcho" Panel.ZIndex="0" Width="14" Height="38"
                  HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-88,212"
                  Data="M 0,0 C 14,7 14,31 0,38" Stroke="#B8E8D9" StrokeThickness="2.5"
                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                  Opacity="0" Visibility="Collapsed" IsHitTestVisible="False">
                <Path.RenderTransform><TranslateTransform x:Name="RulesEchoShift"/></Path.RenderTransform>
            </Path>
            <Button x:Name="RulesTab" Style="{StaticResource PageTabButton}" Tag="Inactive"
                    HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-70,200"
                    ToolTip="Правила получения минут" Click="RulesTab_Click"
                    AutomationProperties.Name="Открыть правила получения минут">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Border Width="26" Height="27" CornerRadius="3" BorderBrush="#245C63"
                                BorderThickness="1.8" Background="#FAFCF8" HorizontalAlignment="Center">
                            <StackPanel Margin="5,6,5,0">
                                <Border Height="2" Background="#245C63" CornerRadius="1" Margin="0,0,0,3"/>
                                <Border Height="2" Background="#245C63" CornerRadius="1" Margin="0,0,0,3"/>
                                <Border Height="2" Width="8" Background="#245C63" CornerRadius="1"
                                        HorizontalAlignment="Left"/>
                            </StackPanel>
                        </Border>
                        <TextBlock Text="Правила" FontSize="10.5" FontWeight="SemiBold" Foreground="#245C63"
                                   HorizontalAlignment="Center" Margin="0,4,0,0"/>
                </StackPanel>
            </Button>
            <Button x:Name="MinutesTab" Style="{StaticResource PageTabButton}" Tag="Active"
                    HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-70,130"
                    ToolTip="Сохранённые минуты" Click="MinutesTab_Click"
                    AutomationProperties.Name="Открыть сохранённые минуты">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Grid Width="27" Height="27" HorizontalAlignment="Center">
                        <Ellipse Stroke="#245C63" StrokeThickness="2.2"/>
                        <Path Data="M 13.5,5 L 13.5,13.5 L 19,13.5" Stroke="#245C63"
                              StrokeThickness="2.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              StrokeLineJoin="Round"/>
                    </Grid>
                    <TextBlock Text="Минуты" FontSize="10.5" FontWeight="SemiBold" Foreground="#245C63"
                               HorizontalAlignment="Center" Margin="0,4,0,0"/>
                </StackPanel>
            </Button>
            <Border x:Name="CardShadowBorder" Panel.ZIndex="1" CornerRadius="27" Background="#FFFEFA" IsHitTestVisible="False">
                <Border.Effect>
                    <DropShadowEffect Color="#071B1C" BlurRadius="24" ShadowDepth="7" Opacity="0.38"/>
                </Border.Effect>
            </Border>
            <Border Panel.ZIndex="2" Padding="42" CornerRadius="27" Background="#FFFEFA"
                    BorderBrush="#E5E9E1" BorderThickness="1">
                <Grid>
                    <StackPanel x:Name="StatusView">
                <TextBlock x:Name="ModeBadge" Text="PARENTCONTROL  /  ПАУЗА" Foreground="#347078" FontSize="12" FontWeight="SemiBold"/>
                <TextBlock x:Name="TitleText" Text="Время для отдыха" FontFamily="Georgia" FontSize="40" Foreground="#1A2929" Margin="0,18,0,10"/>
                <TextBlock x:Name="DescriptionText" Text="Компьютер станет доступен, когда администратор добавит время или наступит разрешённый период."
                           TextWrapping="Wrap" FontSize="16" LineHeight="25" Foreground="#52615E"/>
                <Border Background="#E9F0EA" CornerRadius="15" Padding="18" Margin="0,28,0,24">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock Text="Остаток банка" FontSize="15" Foreground="#52615E"/>
                        <TextBlock x:Name="RemainingText" Grid.Column="1" Text="0 мин" FontSize="16" FontWeight="Bold" Foreground="#1A2929"/>
                    </Grid>
                </Border>
                <Button x:Name="ResumeButton" Style="{StaticResource ActionButton}" Content="Продолжить работу"
                        Click="Resume_Click" HorizontalAlignment="Center" Margin="0,0,0,22" Visibility="Collapsed"/>
                <TextBlock Text="Есть промокод?" FontSize="16" FontWeight="SemiBold" Foreground="#1A2929"/>
                <TextBox x:Name="PromoInput" Style="{StaticResource InputStyle}" FontSize="16"
                         VerticalContentAlignment="Center" Margin="0,12,0,0"/>
                <Button Style="{StaticResource ActionButton}" Content="Применить промокод" Click="Redeem_Click"
                        HorizontalAlignment="Center" Margin="0,12,0,0"/>
                <TextBlock x:Name="MessageText" Foreground="#9B4F45" TextWrapping="Wrap" Margin="0,11,0,0" FontSize="14"/>
                    </StackPanel>
                    <Grid x:Name="RulesView" Height="440" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="Как получить минуты" FontFamily="Georgia" FontSize="36"
                                   Foreground="#1A2929" TextWrapping="Wrap"/>
                        <TextBlock Grid.Row="1" Text="Правила и квоты от администратора"
                                   Foreground="#52615E" Margin="0,10,0,22"/>
                        <Border Grid.Row="2" Background="#F5F8F3" BorderBrush="#DCE7DE"
                                BorderThickness="1" CornerRadius="15" Padding="17">
                            <FlowDocumentScrollViewer x:Name="RulesDocumentViewer"
                                                      IsToolBarVisible="False" VerticalScrollBarVisibility="Auto"/>
                        </Border>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <StackPanel x:Name="PowerControls" Orientation="Horizontal" HorizontalAlignment="Center"
                    VerticalAlignment="Bottom" Margin="0,0,0,24">
            <StackPanel Margin="0,0,16,0" HorizontalAlignment="Center">
                <Button Style="{StaticResource PowerCircleButton}" Tag="restart" Click="Power_Click"
                        ToolTip="Перезагрузить компьютер" AutomationProperties.Name="Перезагрузка">
                    <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="26"
                               Foreground="#225B62" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Button>
                <TextBlock Text="Перезагрузка" Foreground="#F7FAF6" FontSize="11"
                           HorizontalAlignment="Center" Margin="0,7,0,0"/>
            </StackPanel>
            <StackPanel Margin="0,0,16,0" HorizontalAlignment="Center">
                <Button Style="{StaticResource PowerCircleButton}" Tag="shutdown" Click="Power_Click"
                        ToolTip="Выключить компьютер" AutomationProperties.Name="Выключение">
                    <TextBlock Text="&#xE7E8;" FontFamily="Segoe MDL2 Assets" FontSize="26"
                               Foreground="#225B62" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Button>
                <TextBlock Text="Выключение" Foreground="#F7FAF6" FontSize="11"
                           HorizontalAlignment="Center" Margin="0,7,0,0"/>
            </StackPanel>
            <StackPanel Margin="0,0,16,0" HorizontalAlignment="Center">
                <Button Style="{StaticResource PowerCircleButton}" Tag="sleep" Click="Power_Click"
                        ToolTip="Перевести компьютер в сон" AutomationProperties.Name="Сон">
                    <TextBlock Text="&#xE708;" FontFamily="Segoe MDL2 Assets" FontSize="26"
                               Foreground="#225B62" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Button>
                <TextBlock Text="Сон" Foreground="#F7FAF6" FontSize="11"
                           HorizontalAlignment="Center" Margin="0,7,0,0"/>
            </StackPanel>
            <StackPanel HorizontalAlignment="Center">
                <Button x:Name="AdminEntry" Style="{StaticResource PowerCircleButton}"
                        ToolTip="Техническое обслуживание · вход администратора"
                        AutomationProperties.Name="Технический вход администратора" Click="AdminEntry_Click">
                    <TextBlock Text="&#xE77B;" FontFamily="Segoe MDL2 Assets" FontSize="26"
                               Foreground="#225B62" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Button>
                <TextBlock Text="Техвход" Foreground="#F7FAF6" FontSize="11"
                           HorizontalAlignment="Center" Margin="0,7,0,0"/>
            </StackPanel>
        </StackPanel>
        <Border x:Name="ModalScrim" Background="#B0152527" Visibility="Collapsed"/>
        <Border x:Name="AdminPanel" MaxWidth="440" MinWidth="300" Margin="18" Padding="32" CornerRadius="24" Background="#FFFEFA"
                BorderBrush="#E5E9E1" BorderThickness="1" HorizontalAlignment="Stretch" VerticalAlignment="Center" Visibility="Collapsed">
            <StackPanel>
                <TextBlock Text="Технический вход" FontFamily="Georgia" FontSize="29" Foreground="#1A2929"/>
                <TextBlock Text="Временный доступ на 30 минут. Минуты банка в это время не расходуются."
                           Foreground="#52615E" TextWrapping="Wrap" Margin="0,12,0,18"/>
                <TextBlock Text="Пароль администратора" Foreground="#1A2929" FontWeight="SemiBold" Margin="0,0,0,7"/>
                <PasswordBox x:Name="AdminPasswordInput" Style="{StaticResource PasswordStyle}" MaxLength="64" FontSize="17"
                             KeyDown="AdminPassword_KeyDown"/>
                <TextBlock x:Name="AdminMessageText" Foreground="#9B4F45" TextWrapping="Wrap" Margin="0,10,0,0"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,22,0,0">
                    <Button Style="{StaticResource SoftButton}" Content="Отмена" Click="ClosePanels_Click" Margin="0,0,9,0"/>
                    <Button x:Name="AdminUnlockButton" Style="{StaticResource ActionButton}" Content="Открыть доступ" Click="AdminUnlock_Click"/>
                </StackPanel>
                <Button x:Name="AdminStopButton" Style="{StaticResource SoftButton}"
                        Content="Выключить клиент полностью" Click="AdminStop_Click"
                        HorizontalAlignment="Center" Margin="0,12,0,0"/>
            </StackPanel>
        </Border>
        <Border x:Name="PowerPanel" MaxWidth="420" MinWidth="300" Margin="18" Padding="32" CornerRadius="24" Background="#FFFEFA"
                BorderBrush="#E5E9E1" BorderThickness="1" HorizontalAlignment="Stretch" VerticalAlignment="Center" Visibility="Collapsed">
            <StackPanel>
                <TextBlock x:Name="PowerTitle" FontFamily="Georgia" FontSize="29" Foreground="#1A2929"/>
                <TextBlock x:Name="PowerDescription" Foreground="#52615E" TextWrapping="Wrap" Margin="0,12,0,24"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button Style="{StaticResource SoftButton}" Content="Отмена" Click="ClosePanels_Click" Margin="0,0,9,0"/>
                    <Button x:Name="ConfirmPowerButton" Style="{StaticResource ActionButton}" Content="Продолжить" Click="ConfirmPower_Click"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>
